    UpdateOptions.AutoCommitUpdates = True
    SQL.Strings = (
      
        'SELECT GRA_CODIGO,  TAM_TAMANHO, GRA_VALOR, GRA_CODBARRA, GRA_QU' +
        'ANTIDADE, GRA_TAM, GRA_COR FROM GRADES, TAMANHOS WHERE GRA_TAM =' +
